# ---------------------------------------------------
# 1. Data (Strict Project Restriction)
# ---------------------------------------------------
# Ignore all CSV files in the raw folder to avoid uploading the dataset
data/raw/*.csv

# ---------------------------------------------------
# 2. Virtual Environment
# ---------------------------------------------------
# Ignore your Python virtual environment folder
.venv/
venv/
env/

# ---------------------------------------------------
# 3. Python Cache and Test Files
# ---------------------------------------------------
# Ignore binaries and cache generated when running code
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore the cache generated by pytest a moment ago
.pytest_cache/

# ---------------------------------------------------
# 4. IDE Configuration (PyCharm)
# ---------------------------------------------------
# Ignore your code editor's local configurations
.idea/